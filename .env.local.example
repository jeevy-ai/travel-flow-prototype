# Clerk publishable key — get from https://dashboard.clerk.com
# Without this, auth routes are non-functional but the prototype flow still works.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Beta tokens — comma-separated, format: TOKEN or TOKEN:Name
# Example: BETA_TOKENS=NOAH-EARLY:Noah,TEAM-01
VITE_BETA_TOKENS=
